{
  "schema_version": 1,
  "channels": [
    {
      "id": "fcm-environments",
      "kind": "fcm",
      "endpoint": "https://fcm.googleapis.com/v1/projects/REPLACE_PROJECT/messages:send",
      "access_token_command": [
        "/usr/bin/gcloud",
        "auth",
        "application-default",
        "print-access-token"
      ],
      "tokens": [
        {
          "environment_id": "ENV-REPLACE-MAC",
          "token": "REPLACE_LOCAL_FCM_REGISTRATION_TOKEN"
        },
        {
          "environment_id": "ENV-REPLACE-ASTRO",
          "token": "REPLACE_LOCAL_FCM_REGISTRATION_TOKEN"
        }
      ]
    },
    {
      "id": "hermes-discord",
      "kind": "hermes_webhook",
      "endpoint": "http://127.0.0.1:8644/webhooks/under-claw-meta-ready",
      "secret": "REPLACE_LOCAL_HMAC_SECRET"
    }
  ]
}
